# ScholarHub Server Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret (Change this in production)
JWT_SECRET=scholarhub_super_secret_jwt_key_2025_secure_key
JWT_EXPIRES_IN=7d

# MySQL Database Configuration
# Leave DB_PASSWORD empty if using default XAMPP MySQL root with no password
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scholarhub_db

# Storage Mode:
# 'auto' = tries MySQL first; if unreachable, falls back to embedded persistent storage seamlessly
# 'mysql' = enforce MySQL connection
# 'embedded' = use lightweight file-backed database without needing MySQL server
DB_MODE=auto
